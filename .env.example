# 本地私密配置示例：复制为项目根目录 .env 后填写，每行 KEY=VALUE，不要加引号。
# .env 已被 .gitignore 排除，禁止提交到仓库。
# 运行时账号、迁移账号和测试账号应分别创建并限制到对应数据库。
MYSQL_PORT=3306
VITE_PORT=5173

# 主服务运行账号（仅 eldercare 库 DML 权限）
DB_USER=eldercare_app
DB_PASSWORD=

# 独立模拟支付服务运行账号（仅 eldercare_payment 库 DML 权限）
PAYMENT_DB_USER=eldercare_payment_app
PAYMENT_DB_PASSWORD=

# 版本化 SQL 使用的迁移账号（仅 eldercare 与 eldercare_payment 的 DDL/DML 权限）
DB_MIGRATION_USER=eldercare_migrator
DB_MIGRATION_PASSWORD=

# 集成测试账号只允许访问 eldercare_test 与 eldercare_payment_test
TEST_DB_URL=jdbc:mysql://127.0.0.1:3306/eldercare_test?allowMultiQueries=true&useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
TEST_DB_USER=eldercare_test_runner
TEST_DB_PASSWORD=

# 管理员初始密码；仅临时设置 BOOTSTRAP_ADMIN_RESET=true 时重置已存在账号
BOOTSTRAP_ADMIN_PASSWORD=

# 本机演示账号统一密码，请自行设置；勿使用真实老人资料
DEMO_ACCOUNT_PASSWORD=

# 主服务查询模拟支付交易时使用的服务端令牌
PAYMENT_SERVICE_TOKEN=

# 本机模拟支付控制台令牌，会下发到本机浏览器
PAYMENT_CONSOLE_TOKEN=
