# 本地私密配置示例：复制为项目根目录 .env 后填写，每行 KEY=VALUE，不要加引号。
# .env 已被 .gitignore 排除，禁止提交到仓库。
# 两个服务共用同一个 MySQL root 账号，端口固定 3306。

# MySQL root 密码
DB_PASSWORD=

# 管理员初始密码（app.bootstrap-admin-username 默认 admin），本地演示可填 123456
BOOTSTRAP_ADMIN_PASSWORD=

# 演示账号统一密码（user01 / worker01 等），本地演示可填 123456
DEMO_ACCOUNT_PASSWORD=

# 主服务查询模拟支付交易时使用的服务端令牌
PAYMENT_SERVICE_TOKEN=

# 模拟支付测试控制台的访问令牌（会下发到浏览器页面）
PAYMENT_CONSOLE_TOKEN=
